# ========================================
# Douyin → YouTube Shorts Tool
# Copy file này thành .env và điền API keys
# ========================================

# Google Gemini API Key
# Lấy tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube OAuth 2.0 (Google Cloud Console)
# Tạo tại: https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback

# Server Config
PORT=3000
HOST=localhost

# Douyin Cookie (tùy chọn - để tải video ổn định hơn)
# Mở Douyin web → F12 → Network → Copy cookie
DOUYIN_COOKIE=

# Caption Language: vi, en, vi-en (song ngữ)
CAPTION_LANGUAGE=vi

# Caption Style: funny, serious, trending, motivational
CAPTION_STYLE=trending

# YouTube Upload Settings
# Privacy: public, unlisted, private
DEFAULT_PRIVACY=unlisted

# Auto upload: true/false
AUTO_UPLOAD=false

# Max uploads per day (YouTube quota limit ~6)
MAX_UPLOADS_PER_DAY=5
